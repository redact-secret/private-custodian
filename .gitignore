# Convenience only. Gitignore is NOT a disclosure control (CONVENTIONS.md):
# protected assets must live in separately controlled storage and must never
# be created inside this working tree. Verify with `git ls-files`, not this file.

# Protected and operational material: corpora, seeds, ledgers, raw results, keys.
/protected/
/corpus/
/seeds/
/ledgers/
/audit-data/
/private-results/
/scratch/
*.seed
*.ledger
*.pem
*.key
*.p12
*.pfx
.env
.env.*
!.env.example

# Local run artifacts are temporary and never committed or published.
/results/
/runs/

# Build output and dependency installs.
node_modules/
.venv/
__pycache__/
/target/
dist/
build/
coverage/
*.log

# OS and editor.
.DS_Store

# graft's local graph cache: regenerable, not committed (run `graft build`).
/graft/

# Local agent state.
.claude/worktrees
.claude/settings.local.json
