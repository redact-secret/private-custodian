{
  "$defs": {
    "ActivationRef": {
      "additionalProperties": false,
      "description": "Binding to one activation record of a policy. `sequence` is the\nactivation's state sequence seen when the binding was made; any later\nstate (revocation, supersession) has a higher sequence.",
      "properties": {
        "activation_id": {
          "maxLength": 68,
          "minLength": 20,
          "pattern": "^pac_[a-z0-9]{16,64}$",
          "type": "string"
        },
        "policy": {
          "$ref": "#/$defs/PolicyRef"
        },
        "sequence": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "policy",
        "activation_id",
        "sequence"
      ],
      "type": "object"
    },
    "ActorKind": {
      "description": "What kind of principal acted. An agent can propose; it can never approve.",
      "enum": [
        "human",
        "service",
        "agent"
      ],
      "type": "string"
    },
    "ApprovalScope": {
      "description": "What the approval authorizes, bound to exact identities.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Run exactly this plan against exactly this population and budget.",
          "properties": {
            "budget": {
              "$ref": "#/$defs/BudgetScope"
            },
            "candidate": {
              "maxLength": 71,
              "minLength": 71,
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            "operation": {
              "const": "execute",
              "type": "string"
            },
            "plan_digest": {
              "maxLength": 71,
              "minLength": 71,
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            "population": {
              "$ref": "#/$defs/PopulationBinding"
            },
            "request_id": {
              "maxLength": 68,
              "minLength": 20,
              "pattern": "^req_[a-z0-9]{16,64}$",
              "type": "string"
            }
          },
          "required": [
            "operation",
            "request_id",
            "plan_digest",
            "candidate",
            "population",
            "budget"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Release exactly this projection, produced by this execution, under\nthis disclosure policy.",
          "properties": {
            "disclosure_policy": {
              "$ref": "#/$defs/PolicyRef"
            },
            "execution_id": {
              "maxLength": 68,
              "minLength": 20,
              "pattern": "^exe_[a-z0-9]{16,64}$",
              "type": "string"
            },
            "operation": {
              "const": "release",
              "type": "string"
            },
            "projection_digest": {
              "maxLength": 71,
              "minLength": 71,
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            }
          },
          "required": [
            "operation",
            "execution_id",
            "projection_digest",
            "disclosure_policy"
          ],
          "type": "object"
        }
      ]
    },
    "BudgetScope": {
      "description": "Budget scope. Two legacy semantics stay distinct (ADR 0003): holdout\nattempts are per population (and family) epoch; blind attempts are per\ncandidate lineage per epoch. They are different variants, never one counter.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "corpus_id": {
              "maxLength": 68,
              "minLength": 20,
              "pattern": "^cor_[a-z0-9]{16,64}$",
              "type": "string"
            },
            "epoch_id": {
              "maxLength": 68,
              "minLength": 20,
              "pattern": "^epo_[a-z0-9]{16,64}$",
              "type": "string"
            },
            "family_id": {
              "maxLength": 68,
              "minLength": 20,
              "pattern": "^fam_[a-z0-9]{16,64}$",
              "type": "string"
            },
            "scope": {
              "const": "population_epoch",
              "type": "string"
            }
          },
          "required": [
            "scope",
            "corpus_id",
            "epoch_id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "corpus_id": {
              "maxLength": 68,
              "minLength": 20,
              "pattern": "^cor_[a-z0-9]{16,64}$",
              "type": "string"
            },
            "epoch_id": {
              "maxLength": 68,
              "minLength": 20,
              "pattern": "^epo_[a-z0-9]{16,64}$",
              "type": "string"
            },
            "family_id": {
              "maxLength": 68,
              "minLength": 20,
              "pattern": "^fam_[a-z0-9]{16,64}$",
              "type": "string"
            },
            "lineage_id": {
              "maxLength": 68,
              "minLength": 20,
              "pattern": "^lin_[a-z0-9]{16,64}$",
              "type": "string"
            },
            "scope": {
              "const": "candidate_lineage_epoch",
              "type": "string"
            }
          },
          "required": [
            "scope",
            "corpus_id",
            "epoch_id",
            "lineage_id"
          ],
          "type": "object"
        }
      ]
    },
    "EvaluationDomain": {
      "description": "Evaluation domain. Plan, protocol, population and policies must all agree.",
      "enum": [
        "credential",
        "pii"
      ],
      "type": "string"
    },
    "PolicyKind": {
      "oneOf": [
        {
          "enum": [
            "budget",
            "retention",
            "signer"
          ],
          "type": "string"
        },
        {
          "const": "approval",
          "description": "Execution approval and authorization rules.",
          "type": "string"
        },
        {
          "const": "disclosure",
          "description": "Projection allowlist, strata and composition rules.",
          "type": "string"
        }
      ]
    },
    "PolicyRef": {
      "additionalProperties": false,
      "description": "A named, versioned policy. Changing a policy is a reviewed revision, i.e. a\nnew version, never an in-place edit.",
      "properties": {
        "domain": {
          "$ref": "#/$defs/EvaluationDomain"
        },
        "kind": {
          "$ref": "#/$defs/PolicyKind"
        },
        "name": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
          "type": "string"
        },
        "version": {
          "maximum": 1000000,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "domain",
        "name",
        "version"
      ],
      "type": "object"
    },
    "PopulationBinding": {
      "additionalProperties": false,
      "description": "Internal population binding. Never public: it names custody identities.",
      "properties": {
        "corpus_id": {
          "maxLength": 68,
          "minLength": 20,
          "pattern": "^cor_[a-z0-9]{16,64}$",
          "type": "string"
        },
        "custody_version": {
          "maximum": 1000000,
          "minimum": 0,
          "type": "integer"
        },
        "domain": {
          "$ref": "#/$defs/EvaluationDomain"
        },
        "epoch_id": {
          "maxLength": 68,
          "minLength": 20,
          "pattern": "^epo_[a-z0-9]{16,64}$",
          "type": "string"
        },
        "family_id": {
          "maxLength": 68,
          "minLength": 20,
          "pattern": "^fam_[a-z0-9]{16,64}$",
          "type": "string"
        },
        "population_digest": {
          "maxLength": 71,
          "minLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "domain",
        "corpus_id",
        "epoch_id",
        "population_digest",
        "custody_version"
      ],
      "type": "object"
    },
    "RoleSeparation": {
      "description": "How proposal, execution approval and disclosure approval are separated.\nBoth variants are procedural. There is deliberately no organizational\nvariant: it is not offered until a reviewed schema revision adds one.",
      "oneOf": [
        {
          "const": "single_operator_procedural",
          "description": "One person holds the roles; separation is a procedure, not a control.",
          "type": "string"
        },
        {
          "const": "distinct_principals_procedural",
          "description": "Distinct principals, still within one organization.",
          "type": "string"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "activation": {
      "$ref": "#/$defs/ActivationRef"
    },
    "approval_id": {
      "maxLength": 68,
      "minLength": 20,
      "pattern": "^apr_[a-z0-9]{16,64}$",
      "type": "string"
    },
    "approver": {
      "maxLength": 68,
      "minLength": 20,
      "pattern": "^act_[a-z0-9]{16,64}$",
      "type": "string"
    },
    "approver_kind": {
      "$ref": "#/$defs/ActorKind"
    },
    "expires_at": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "issued_at": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "proposer": {
      "maxLength": 68,
      "minLength": 20,
      "pattern": "^act_[a-z0-9]{16,64}$",
      "type": "string"
    },
    "role_separation": {
      "$ref": "#/$defs/RoleSeparation"
    },
    "schema": {
      "const": "private-custodian.approval/1"
    },
    "scope": {
      "$ref": "#/$defs/ApprovalScope"
    }
  },
  "required": [
    "schema",
    "approval_id",
    "scope",
    "activation",
    "proposer",
    "approver",
    "approver_kind",
    "role_separation",
    "issued_at",
    "expires_at"
  ],
  "title": "Approval",
  "type": "object"
}
