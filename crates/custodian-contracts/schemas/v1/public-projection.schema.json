{
  "$defs": {
    "AggregateCell": {
      "additionalProperties": false,
      "properties": {
        "metric": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
          "type": "string"
        },
        "stratum": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/CellValue"
        }
      },
      "required": [
        "stratum",
        "metric",
        "value"
      ],
      "type": "object"
    },
    "ArtifactIdentity": {
      "additionalProperties": false,
      "description": "A named, versioned, content-addressed component (engine, adapter, scanner).",
      "properties": {
        "digest": {
          "maxLength": 71,
          "minLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "name": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
          "type": "string"
        },
        "version": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "digest"
      ],
      "type": "object"
    },
    "Attestation": {
      "additionalProperties": false,
      "properties": {
        "authorship": {
          "$ref": "#/$defs/Authorship"
        },
        "ground_truth": {
          "$ref": "#/$defs/GroundTruthClaim"
        },
        "independence": {
          "$ref": "#/$defs/IndependenceClaim"
        },
        "organisational_independence": {
          "$ref": "#/$defs/OrganisationalIndependence"
        },
        "review": {
          "$ref": "#/$defs/ReviewStatus"
        },
        "role_separation": {
          "$ref": "#/$defs/RoleSeparation"
        }
      },
      "required": [
        "independence",
        "role_separation",
        "organisational_independence",
        "authorship",
        "review",
        "ground_truth"
      ],
      "type": "object"
    },
    "Authorship": {
      "description": "Who authored expectations. `external_*` values are declarations by the\ncustodian operator and are not verified by this system.",
      "enum": [
        "project_authored",
        "external_authored_unverified"
      ],
      "type": "string"
    },
    "CellValue": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "denominator": {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            "numerator": {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            "state": {
              "const": "reported",
              "type": "string"
            }
          },
          "required": [
            "state",
            "numerator",
            "denominator"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Withheld by the disclosure policy (small cell or composition rule).\nCarries no value, bound or hint.",
          "properties": {
            "state": {
              "const": "suppressed",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        }
      ]
    },
    "EvaluationDomain": {
      "description": "Evaluation domain. Plan, protocol, population and policies must all agree.",
      "enum": [
        "credential",
        "pii"
      ],
      "type": "string"
    },
    "FeedRef": {
      "additionalProperties": false,
      "description": "Where a consumer finds revocation state for this projection, and the\noldest feed state it must have seen to rely on it.",
      "properties": {
        "feed_id": {
          "maxLength": 68,
          "minLength": 20,
          "pattern": "^fed_[a-z0-9]{16,64}$",
          "type": "string"
        },
        "min_sequence": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "feed_id",
        "min_sequence"
      ],
      "type": "object"
    },
    "GroundTruthClaim": {
      "description": "Custody and signatures attest origin and binding, never truth.",
      "enum": [
        "not_established"
      ],
      "type": "string"
    },
    "IndependenceClaim": {
      "description": "Legacy independence vocabulary, preserved verbatim (ADR 0003). None of\nthese means \"independent\".",
      "enum": [
        "public-control",
        "custodian-declared",
        "procedural-separation"
      ],
      "type": "string"
    },
    "OrganisationalIndependence": {
      "description": "Organizational independence. The only representable value is `not_claimed`.",
      "enum": [
        "not_claimed"
      ],
      "type": "string"
    },
    "PolicyKind": {
      "oneOf": [
        {
          "enum": [
            "budget",
            "retention",
            "signer"
          ],
          "type": "string"
        },
        {
          "const": "approval",
          "description": "Execution approval and authorization rules.",
          "type": "string"
        },
        {
          "const": "disclosure",
          "description": "Projection allowlist, strata and composition rules.",
          "type": "string"
        }
      ]
    },
    "PolicyRef": {
      "additionalProperties": false,
      "description": "A named, versioned policy. Changing a policy is a reviewed revision, i.e. a\nnew version, never an in-place edit.",
      "properties": {
        "domain": {
          "$ref": "#/$defs/EvaluationDomain"
        },
        "kind": {
          "$ref": "#/$defs/PolicyKind"
        },
        "name": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
          "type": "string"
        },
        "version": {
          "maximum": 1000000,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "domain",
        "name",
        "version"
      ],
      "type": "object"
    },
    "ProtocolRef": {
      "additionalProperties": false,
      "description": "Measurement protocol, versioned separately from schemas and policies. The\nlegacy TypeScript semantics are a named protocol here, never an implicit one.",
      "properties": {
        "domain": {
          "$ref": "#/$defs/EvaluationDomain"
        },
        "name": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
          "type": "string"
        },
        "version": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
          "type": "string"
        }
      },
      "required": [
        "domain",
        "name",
        "version"
      ],
      "type": "object"
    },
    "PublicPopulationRef": {
      "description": "Disclosure-safe population identity. Either a random opaque reference or a\nkeyed commitment; never a plain hash of population content.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "id": {
              "maxLength": 68,
              "minLength": 20,
              "pattern": "^ppr_[a-z0-9]{16,64}$",
              "type": "string"
            },
            "kind": {
              "const": "opaque",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "commitment": {
              "maxLength": 76,
              "minLength": 76,
              "pattern": "^hmac-sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            "key_id": {
              "maxLength": 68,
              "minLength": 20,
              "pattern": "^key_[a-z0-9]{16,64}$",
              "type": "string"
            },
            "kind": {
              "const": "keyed_commitment",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "key_id",
            "commitment"
          ],
          "type": "object"
        }
      ]
    },
    "PublicProjection": {
      "additionalProperties": false,
      "properties": {
        "attestation": {
          "$ref": "#/$defs/Attestation"
        },
        "candidate": {
          "maxLength": 71,
          "minLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "cells": {
          "items": {
            "$ref": "#/$defs/AggregateCell"
          },
          "maxItems": 256,
          "type": "array"
        },
        "disclosure_policy": {
          "$ref": "#/$defs/PolicyRef"
        },
        "domain": {
          "$ref": "#/$defs/EvaluationDomain"
        },
        "engine": {
          "$ref": "#/$defs/ArtifactIdentity"
        },
        "fresh_until": {
          "description": "The projection is not to be relied on after this time even if no\nrevocation was published.",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "issued_at": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "population": {
          "$ref": "#/$defs/PublicPopulationRef"
        },
        "projection_id": {
          "maxLength": 68,
          "minLength": 20,
          "pattern": "^prj_[a-z0-9]{16,64}$",
          "type": "string"
        },
        "protocol": {
          "$ref": "#/$defs/ProtocolRef"
        },
        "receipt_id": {
          "description": "Public receipt identity (random, unrelated to internal ids).",
          "maxLength": 68,
          "minLength": 20,
          "pattern": "^rcp_[a-z0-9]{16,64}$",
          "type": "string"
        },
        "revocation_feed": {
          "$ref": "#/$defs/FeedRef"
        },
        "schema": {
          "const": "private-custodian.public-projection/1"
        },
        "scope_kind": {
          "$ref": "#/$defs/ScopeKind"
        }
      },
      "required": [
        "schema",
        "projection_id",
        "receipt_id",
        "domain",
        "population",
        "candidate",
        "engine",
        "protocol",
        "scope_kind",
        "disclosure_policy",
        "attestation",
        "cells",
        "issued_at",
        "fresh_until",
        "revocation_feed"
      ],
      "type": "object"
    },
    "ReviewStatus": {
      "enum": [
        "not_reviewed",
        "project_reviewed",
        "external_reviewed_unverified"
      ],
      "type": "string"
    },
    "RoleSeparation": {
      "description": "How proposal, execution approval and disclosure approval are separated.\nBoth variants are procedural. There is deliberately no organizational\nvariant: it is not offered until a reviewed schema revision adds one.",
      "oneOf": [
        {
          "const": "single_operator_procedural",
          "description": "One person holds the roles; separation is a procedure, not a control.",
          "type": "string"
        },
        {
          "const": "distinct_principals_procedural",
          "description": "Distinct principals, still within one organization.",
          "type": "string"
        }
      ]
    },
    "ScopeKind": {
      "description": "Which budget semantics produced the run, without any internal identity.",
      "enum": [
        "population_epoch",
        "candidate_lineage_epoch"
      ],
      "type": "string"
    },
    "Signature": {
      "additionalProperties": false,
      "description": "Signature over `Contract::signing_input` of the enclosed payload.",
      "properties": {
        "algorithm": {
          "$ref": "#/$defs/SignatureAlgorithm"
        },
        "key_id": {
          "maxLength": 68,
          "minLength": 20,
          "pattern": "^key_[a-z0-9]{16,64}$",
          "type": "string"
        },
        "value": {
          "maxLength": 86,
          "minLength": 86,
          "pattern": "^[A-Za-z0-9_-]{86}$",
          "type": "string"
        }
      },
      "required": [
        "key_id",
        "algorithm",
        "value"
      ],
      "type": "object"
    },
    "SignatureAlgorithm": {
      "enum": [
        "ed25519"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Signed public projection: payload plus signature over\n`payload.signing_input()` (domain `public-projection`).",
  "properties": {
    "payload": {
      "$ref": "#/$defs/PublicProjection"
    },
    "signature": {
      "$ref": "#/$defs/Signature"
    }
  },
  "required": [
    "payload",
    "signature"
  ],
  "title": "PublicProjectionEnvelope",
  "type": "object"
}
